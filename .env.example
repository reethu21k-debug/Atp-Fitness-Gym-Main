# ==============================
# SUPABASE
# ==============================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_JWT_SECRET=

# ==============================
# CLOUDINARY
# ==============================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=gymos_unsigned

# ==============================
# AUTH PROVIDERS
# ==============================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# ==============================
# EMAIL (Resend primary, Gmail SMTP fallback)
# ==============================
# Resend -- primary provider. Requires a verified sending domain (SPF/DKIM/
# DMARC) in the Resend dashboard for reliable inbox placement.
RESEND_API_KEY=
EMAIL_FROM=GymOS <no-reply@gymos.app>

# Gmail SMTP -- optional fallback, used automatically if RESEND_API_KEY is
# not set, or if a Resend send fails. Requires a Gmail account with 2-Step
# Verification and an App Password (Google Account -> Security -> 2-Step
# Verification -> App passwords) -- a normal Gmail password will NOT work.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
EMAIL_FROM_NAME=GymOS

# ==============================
# WHATSAPP CLOUD API (Meta) -- ALL WhatsApp messaging
# This is the only WhatsApp integration in the project. There is no Twilio
# relay anywhere: every send goes directly to graph.facebook.com.
# ==============================
# Get these from developers.facebook.com -> your app -> WhatsApp -> API Setup.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v21.0
# REQUIRED IN PRODUCTION. Meta only allows free-form text within 24 hours of
# the member's last inbound message. Both subscription alerts are
# business-initiated, so without approved Message Templates they are rejected
# with error 131047 -- which is why the expiry message never arrives in
# production. Create + get these approved in WhatsApp Manager, then set the
# template NAMES here (not the text).
WHATSAPP_SUBSCRIPTION_CONFIRMED_TEMPLATE=
WHATSAPP_SUBSCRIPTION_EXPIRED_TEMPLATE=
# Must match the language the template is registered under in WhatsApp Manager
# -- usually "en", not "en_US". A mismatch returns a 404, not a 400.
WHATSAPP_TEMPLATE_LANGUAGE=en
# Prepended to bare national numbers stored without a country code (91 = India).
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# -- Welcome-message templates ------------------------------------------------
# Member/staff welcome messages are business-initiated too, so outside the 24h
# session window Meta rejects plain text exactly as it does the subscription
# alerts. Optional in development against a Meta test number; required for real
# recipients. Set to the approved template NAMES.
WHATSAPP_MEMBER_WELCOME_TEMPLATE=
WHATSAPP_STAFF_WELCOME_TEMPLATE=

# -- Delivery-status webhook (app/api/webhooks/whatsapp) ----------------------
# Any random string you choose; enter the SAME value in the Meta dashboard
# under WhatsApp > Configuration > Webhook > Verify token.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret: App Dashboard > Settings > Basic > App Secret. Used to
# verify the X-Hub-Signature-256 HMAC on every incoming webhook. Without it the
# webhook endpoint refuses all traffic rather than trusting unsigned payloads.
WHATSAPP_APP_SECRET=

# ==============================
# PUSH NOTIFICATIONS
# ==============================
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ==============================
# AI (Anthropic Claude)
# ==============================
ANTHROPIC_API_KEY=

# ==============================
# PAYMENTS
# ==============================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ==============================
# ATTENDANCE
# ==============================
QR_SECRET=

# ==============================
# APP
# ==============================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GymOS

# ==============================
# SCHEDULED JOBS
# ==============================
# Shared secret for every /api/cron/* route AND /api/test-whatsapp. Sent as
# `x-cron-secret` by Supabase pg_cron and as `Authorization: Bearer` by Vercel
# Cron; both are accepted. Generate with: openssl rand -hex 32
# These endpoints FAIL CLOSED -- if this is unset they reject all requests.
CRON_SECRET=
